# Banco PostgreSQL usado pelo catálogo via Prisma. Obrigatório no build e
# no runtime. Configure como segredo na plataforma de deploy.
DATABASE_URL=postgresql://usuario:senha@host:5432/banco?sslmode=require

# Mantido apenas para as ferramentas legadas da integração Tiny. A vitrine
# atual usa PostgreSQL/Prisma independentemente deste valor.
DATA_SOURCE=mock

# URL pública da loja — usada para montar links absolutos de Open Graph
# (preview ao compartilhar no WhatsApp). NÃO é segredo, por isso pode
# (e deve) usar o prefixo NEXT_PUBLIC_ — ao contrário das credenciais da
# Tiny abaixo. Ver docs/BRAND_GUIDELINES.md §6.
NEXT_PUBLIC_SITE_URL=https://lovemimos.example.com

# --- Credenciais da Tiny ERP (só necessárias se DATA_SOURCE=tiny) ---
# Geradas em: ERP Tiny > Configurações > Aplicativos > "+ novo aplicativo".
# NUNCA prefixar essas variáveis com NEXT_PUBLIC_ — isso as exporia no
# navegador. Elas só devem ser lidas em código server-only (ver
# src/lib/repositories/tiny/tiny-client.ts).
#
# A partir da Sprint 5A, essas 3 variáveis passam por validação de
# formato, não só de presença (ver src/lib/env.ts validateTinyEnv) —
# um valor com espaço em branco, mais curto que 8 caracteres, ou igual a
# um placeholder óbvio (ex.: "changeme") é tratado como inválido, com o
# mesmo efeito prático de estar ausente (fallback para o mock).
TINY_CLIENT_ID=
TINY_CLIENT_SECRET=

# O fluxo OAuth2 da Tiny é "authorization_code": um humano precisa logar
# uma vez no navegador para gerar o refresh_token inicial (ver
# docs/API_TINY.md §2). Esse refresh_token vai aqui — o servidor o usa
# para renovar o access_token automaticamente a cada ~4h.
# ATENÇÃO: o refresh_token da Tiny expira em 24h. Se a integração ficar
# muito tempo sem rodar, será necessário reautorizar manualmente e gerar
# um novo. Ver risco documentado em docs/API_TINY.md §11.
TINY_REFRESH_TOKEN=

# URL de redirecionamento cadastrada no aplicativo Tiny — só usada durante
# a autorização manual inicial (geração do primeiro refresh_token), não em
# runtime normal do servidor.
TINY_REDIRECT_URI=http://localhost:3000/api/tiny/callback

# Timeout (ms) para chamadas à API da Tiny antes de acionar o fallback
# para o mock. Ver docs/API_TINY.md §7.
TINY_REQUEST_TIMEOUT_MS=8000

# --- Token da API v2 da Tiny (diferente das credenciais acima!) ---
# Usado SÓ pela página de diagnóstico temporária
# /dev/tiny-connection-test (ver docs/features/tiny-connection-test.md)
# — não é usado por nenhuma parte da integração real (que é v3/OAuth2,
# com as 3 variáveis acima). A API v2 usa um único token estático, sem
# fluxo OAuth2, gerado em: ERP Tiny > Configurações > API.
# NUNCA prefixar com NEXT_PUBLIC_ — isso o exporia no navegador.
TINY_API_TOKEN=
