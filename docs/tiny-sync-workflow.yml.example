# Activate as .github/workflows/tiny-sync.yml ONLY after real batch validation.
name: Tiny catalog sync
on:
  schedule:
    - cron: '7,17,27,37,47,57 * * * *'
  workflow_dispatch:
permissions: {}
concurrency:
  group: tiny-catalog-sync-production
  cancel-in-progress: false
jobs:
  sync:
    runs-on: ubuntu-latest
    timeout-minutes: 45
    steps:
      - name: Resume up to ten batches
        env:
          TINY_SYNC_SECRET: ${{ secrets.TINY_SYNC_SECRET }}
          VERCEL_AUTOMATION_BYPASS_SECRET: ${{ secrets.VERCEL_AUTOMATION_BYPASS_SECRET }}
        run: |
          python3 - <<'PY'
          import json, os, sys, time, urllib.request, urllib.error
          secret = os.environ.get('TINY_SYNC_SECRET', '').strip()
          if not secret:
              sys.exit('TINY_SYNC_SECRET is not configured')
          class NoRedirect(urllib.request.HTTPRedirectHandler):
              def redirect_request(self, *args, **kwargs): return None
          client = urllib.request.build_opener(NoRedirect)
          headers = {'Authorization': 'Bearer ' + secret, 'Content-Type': 'application/json'}
          bypass = os.environ.get('VERCEL_AUTOMATION_BYPASS_SECRET', '').strip()
          if bypass: headers['x-vercel-protection-bypass'] = bypass
          url = 'https://love-mimos-express-sabg.vercel.app/api/admin/sync/tiny'
          for batch in range(1, 11):
              try:
                  request = urllib.request.Request(url, data=b'{}', headers=headers, method='POST')
                  with client.open(request, timeout=250) as response:
                      if not 200 <= response.status < 300: sys.exit('Non-2xx response')
                      result = json.load(response)
              except urllib.error.HTTPError as error:
                  sys.exit('Sync HTTP ' + str(error.code))
              except Exception:
                  sys.exit('Sync transport/JSON error; progress will resume next run')
              status = result.get('status')
              more = result.get('hasMore')
              if result.get('ok') is not True or status not in ('PARTIAL', 'SUCCESS'):
                  sys.exit('Invalid sync result')
              if (status == 'SUCCESS' and more is not False) or (status == 'PARTIAL' and more is not True):
                  sys.exit('Inconsistent sync result')
              print('Batch', batch, status, 'processed:', result.get('processedThisBatch', 0))
              if status == 'SUCCESS': break
              if batch < 10: time.sleep(3)
          else:
              print('Batch limit reached; the next schedule resumes persisted progress')
          PY
